<?xml version="1.0" ?>
<robot name="stanford_arm">
	<!-- ********** KINEMATIC PROPERTIES (JOINTS) ********** -->
	<joint name="world_joint" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
	</joint>

	<!-- Joint 1: waist rotation about Z -->
	<joint name="joint1" type="revolute">
		<parent link="base_link"/>
		<child link="link1"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.412"/>
		<axis xyz="0 0 1"/>
		<limit effort="100" velocity="2.0" lower="-2.9671" upper="2.9671"/>
	</joint>

	<!-- Joint 2: shoulder pitch about Y -->
	<joint name="joint2" type="revolute">
		<parent link="link1"/>
		<child link="link2"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.05"/>
		<axis xyz="0 1 0"/>
		<limit effort="100" velocity="2.0" lower="-2.9671" upper="2.9671"/>
	</joint>

	<!-- Joint 3: telescoping forearm (prismatic along Z), d2=0.154m shoulder offset -->
	<!-- Range: 12–50 in (0.3048–1.2700 m) per Dobrotin & Scheinman IJCAI 1973 -->
	<joint name="joint3" type="prismatic">
		<parent link="link2"/>
		<child link="link3"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.154 0.0"/>
		<axis xyz="0 0 1"/>
		<limit effort="50" velocity="0.5" lower="0.3048" upper="1.2700"/>
	</joint>

	<!-- Joint 4: wrist roll about Z -->
	<joint name="joint4" type="revolute">
		<parent link="link3"/>
		<child link="link4"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		<axis xyz="0 0 1"/>
		<limit effort="20" velocity="3.0" lower="-2.9671" upper="2.9671"/>
	</joint>

	<!-- Joint 5: wrist pitch about Y -->
	<joint name="joint5" type="revolute">
		<parent link="link4"/>
		<child link="link5"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.05"/>
		<axis xyz="0 1 0"/>
		<limit effort="10" velocity="3.0" lower="-1.5708" upper="1.5708"/>
	</joint>

	<!-- Joint 6: wrist yaw about Z -->
	<joint name="joint6" type="revolute">
		<parent link="link5"/>
		<child link="link6"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		<axis xyz="0 0 1"/>
		<limit effort="5" velocity="3.0" lower="-2.9671" upper="2.9671"/>
	</joint>

	<joint name="ee_joint" type="fixed">
		<parent link="link6"/>
		<child link="ee_link"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.08"/>
	</joint>

	<!-- ********** INERTIAL PROPERTIES (LINKS) ********** -->
	<link name="world"/>

	<link name="base_link">
		<inertial>
			<mass value="10.0"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.2"/>
			<inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.03"/>
		</inertial>
	</link>

	<link name="link1">
		<inertial>
			<mass value="3.0"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.025"/>
			<inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
		</inertial>
	</link>

	<link name="link2">
		<inertial>
			<mass value="2.0"/>
			<origin rpy="0 0 0" xyz="0.0 0.077 0.0"/>
			<inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.01"/>
		</inertial>
	</link>

	<link name="link3">
		<inertial>
			<mass value="1.5"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.2"/>
			<inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.005"/>
		</inertial>
	</link>

	<link name="link4">
		<inertial>
			<mass value="0.5"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.025"/>
			<inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
		</inertial>
	</link>

	<link name="link5">
		<inertial>
			<mass value="0.3"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
			<inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
		</inertial>
	</link>

	<link name="link6">
		<inertial>
			<mass value="0.2"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.04"/>
			<inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
		</inertial>
	</link>

	<link name="ee_link"/>
</robot>
