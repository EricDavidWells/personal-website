<?xml version="1.0" ?>
<robot name="gantry">
	<!-- ********** KINEMATIC PROPERTIES (JOINTS) ********** -->
	<joint name="world_joint" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.5"/>
	</joint>

	<!-- Joint X: horizontal travel along X -->
	<joint name="joint_x" type="prismatic">
		<parent link="base_link"/>
		<child link="link_x"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		<axis xyz="1 0 0"/>
		<limit effort="100" velocity="1.0" lower="-0.5" upper="0.5"/>
	</joint>

	<!-- Joint Y: horizontal travel along Y -->
	<joint name="joint_y" type="prismatic">
		<parent link="link_x"/>
		<child link="link_y"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		<axis xyz="0 1 0"/>
		<limit effort="100" velocity="1.0" lower="-0.5" upper="0.5"/>
	</joint>

	<!-- Joint Z: vertical travel (tool descends downward) -->
	<joint name="joint_z" type="prismatic">
		<parent link="link_y"/>
		<child link="link_z"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		<axis xyz="0 0 1"/>
		<limit effort="50" velocity="0.5" lower="-0.4" upper="0.0"/>
	</joint>

	<joint name="ee_joint" type="fixed">
		<parent link="link_z"/>
		<child link="ee_link"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
	</joint>

	<!-- ********** INERTIAL PROPERTIES (LINKS) ********** -->
	<link name="world"/>

	<link name="base_link">
		<inertial>
			<mass value="20.0"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
			<inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
		</inertial>
	</link>

	<link name="link_x">
		<inertial>
			<mass value="5.0"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
			<inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
		</inertial>
	</link>

	<link name="link_y">
		<inertial>
			<mass value="3.0"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
			<inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.03"/>
		</inertial>
	</link>

	<link name="link_z">
		<inertial>
			<mass value="1.0"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
			<inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
		</inertial>
	</link>

	<link name="ee_link"/>
</robot>
