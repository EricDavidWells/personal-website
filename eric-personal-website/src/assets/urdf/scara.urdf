<?xml version="1.0" ?>
<robot name="scara">
	<!-- ********** KINEMATIC PROPERTIES (JOINTS) ********** -->
	<joint name="world_joint" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
	</joint>

	<!-- Joint 1: shoulder rotation about Z -->
	<joint name="joint1" type="revolute">
		<parent link="base_link"/>
		<child link="link1"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.1"/>
		<axis xyz="0 0 1"/>
		<limit effort="50" velocity="2.0" lower="-2.9671" upper="2.9671"/>
	</joint>

	<!-- Joint 2: elbow rotation about Z -->
	<joint name="joint2" type="revolute">
		<parent link="link1"/>
		<child link="link2"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.35 0.0 0.0"/>
		<axis xyz="0 0 1"/>
		<limit effort="50" velocity="2.0" lower="-2.9671" upper="2.9671"/>
	</joint>

	<!-- Joint 3: vertical prismatic (quill) -->
	<joint name="joint3" type="prismatic">
		<parent link="link2"/>
		<child link="link3"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.35 0.0 0.0"/>
		<axis xyz="0 0 1"/>
		<limit effort="50" velocity="0.5" lower="-0.2" upper="0.0"/>
	</joint>

	<!-- Joint 4: wrist rotation about Z -->
	<joint name="joint4" type="revolute">
		<parent link="link3"/>
		<child link="link4"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		<axis xyz="0 0 1"/>
		<limit effort="10" velocity="3.0" lower="-6.2832" upper="6.2832"/>
	</joint>

	<joint name="ee_joint" type="fixed">
		<parent link="link4"/>
		<child link="ee_link"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.05"/>
	</joint>

	<!-- ********** INERTIAL PROPERTIES (LINKS) ********** -->
	<link name="world"/>

	<link name="base_link">
		<inertial>
			<mass value="5.0"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.05"/>
			<inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
		</inertial>
	</link>

	<link name="link1">
		<inertial>
			<mass value="1.5"/>
			<origin rpy="0 0 0" xyz="0.175 0.0 0.0"/>
			<inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
		</inertial>
	</link>

	<link name="link2">
		<inertial>
			<mass value="1.0"/>
			<origin rpy="0 0 0" xyz="0.175 0.0 0.0"/>
			<inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.015"/>
		</inertial>
	</link>

	<link name="link3">
		<inertial>
			<mass value="0.5"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 -0.1"/>
			<inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.001"/>
		</inertial>
	</link>

	<link name="link4">
		<inertial>
			<mass value="0.2"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 -0.025"/>
			<inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
		</inertial>
	</link>

	<link name="ee_link"/>
</robot>
