<?xml version="1.0" ?>
<robot name="fr3">
	<!-- ********** KINEMATIC PROPERTIES (JOINTS) ********** -->
	<joint name="world_joint" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
	</joint>

	<!-- Joint 1: waist rotation about Z — limits ±2.9007 rad (±166.2°) -->
	<joint name="fr3_joint1" type="revolute">
		<parent link="base_link"/>
		<child link="fr3_link1"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.333"/>
		<axis xyz="0 0 1"/>
		<limit effort="87" velocity="2.62" lower="-2.9007" upper="2.9007"/>
	</joint>

	<!-- Joint 2: shoulder — limits ±1.8361 rad (±105.2°) -->
	<joint name="fr3_joint2" type="revolute">
		<parent link="fr3_link1"/>
		<child link="fr3_link2"/>
		<origin rpy="-1.57079632679 0.0 0.0" xyz="0.0 0.0 0.0"/>
		<axis xyz="0 0 1"/>
		<limit effort="87" velocity="2.62" lower="-1.8361" upper="1.8361"/>
	</joint>

	<!-- Joint 3: elbow rotation — limits ±2.9007 rad (±166.2°) -->
	<joint name="fr3_joint3" type="revolute">
		<parent link="fr3_link2"/>
		<child link="fr3_link3"/>
		<origin rpy="1.57079632679 0.0 0.0" xyz="0.0 -0.316 0.0"/>
		<axis xyz="0 0 1"/>
		<limit effort="87" velocity="2.62" lower="-2.9007" upper="2.9007"/>
	</joint>

	<!-- Joint 4: elbow (always bent down) — limits -3.0770 to -0.1169 rad -->
	<joint name="fr3_joint4" type="revolute">
		<parent link="fr3_link3"/>
		<child link="fr3_link4"/>
		<origin rpy="1.57079632679 0.0 0.0" xyz="0.0825 0.0 0.0"/>
		<axis xyz="0 0 1"/>
		<limit effort="87" velocity="2.62" lower="-3.0770" upper="-0.1169"/>
	</joint>

	<!-- Joint 5: wrist pitch — limits ±2.8763 rad (±164.8°) -->
	<joint name="fr3_joint5" type="revolute">
		<parent link="fr3_link4"/>
		<child link="fr3_link5"/>
		<origin rpy="-1.57079632679 0.0 0.0" xyz="-0.0825 0.384 0.0"/>
		<axis xyz="0 0 1"/>
		<limit effort="12" velocity="5.26" lower="-2.8763" upper="2.8763"/>
	</joint>

	<!-- Joint 6: wrist roll — limits 0.4398 to 4.6216 rad (25.2° to 264.8°) -->
	<joint name="fr3_joint6" type="revolute">
		<parent link="fr3_link5"/>
		<child link="fr3_link6"/>
		<origin rpy="1.57079632679 0.0 0.0" xyz="0.0 0.0 0.0"/>
		<axis xyz="0 0 1"/>
		<limit effort="12" velocity="4.18" lower="0.4398" upper="4.6216"/>
	</joint>

	<!-- Joint 7: wrist yaw — limits ±3.0508 rad (±174.8°) -->
	<joint name="fr3_joint7" type="revolute">
		<parent link="fr3_link6"/>
		<child link="fr3_link7"/>
		<origin rpy="1.57079632679 0.0 0.0" xyz="0.088 0.0 0.0"/>
		<axis xyz="0 0 1"/>
		<limit effort="12" velocity="5.26" lower="-3.0508" upper="3.0508"/>
	</joint>

	<!-- Flange to end-effector (107 mm along Z) -->
	<joint name="ee_joint" type="fixed">
		<parent link="fr3_link7"/>
		<child link="ee_link"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.107"/>
	</joint>

	<!-- ********** INERTIAL PROPERTIES (LINKS) ********** -->
	<link name="world"/>

	<link name="base_link">
		<inertial>
			<mass value="3.06"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
			<inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3"/>
		</inertial>
	</link>

	<link name="fr3_link1">
		<inertial>
			<mass value="2.34"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
			<inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3"/>
		</inertial>
	</link>

	<link name="fr3_link2">
		<inertial>
			<mass value="2.36"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
			<inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3"/>
		</inertial>
	</link>

	<link name="fr3_link3">
		<inertial>
			<mass value="2.38"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
			<inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3"/>
		</inertial>
	</link>

	<link name="fr3_link4">
		<inertial>
			<mass value="2.43"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
			<inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3"/>
		</inertial>
	</link>

	<link name="fr3_link5">
		<inertial>
			<mass value="3.50"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
			<inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3"/>
		</inertial>
	</link>

	<link name="fr3_link6">
		<inertial>
			<mass value="1.47"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
			<inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3"/>
		</inertial>
	</link>

	<link name="fr3_link7">
		<inertial>
			<mass value="0.45"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
			<inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3"/>
		</inertial>
	</link>

	<link name="ee_link"/>
</robot>
