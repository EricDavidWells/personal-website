<?xml version="1.0" ?>
<robot name="shoulder_3r">
	<!-- Pure 3R spherical shoulder: all three revolute axes intersect at a single point.
	     ZYX configuration — yaw (Z), pitch (Y), roll (X).
	     EE traces a sphere of radius 0.4 m. Gimbal-lock singularity at pitch = ±90°. -->

	<!-- ********** KINEMATIC PROPERTIES (JOINTS) ********** -->
	<joint name="world_joint" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
	</joint>

	<!-- Joint 1: yaw about Z -->
	<joint name="joint1" type="revolute">
		<parent link="base_link"/>
		<child link="link1"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.2"/>
		<axis xyz="0 0 1"/>
		<limit effort="50" velocity="3.0" lower="-3.14159" upper="3.14159"/>
	</joint>

	<!-- Joint 2: pitch about Y — axis intersects joint1 axis at shoulder center -->
	<joint name="joint2" type="revolute">
		<parent link="link1"/>
		<child link="link2"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		<axis xyz="0 1 0"/>
		<limit effort="50" velocity="3.0" lower="-1.5708" upper="1.5708"/>
	</joint>

	<!-- Joint 3: roll about X — axis intersects both prior axes at shoulder center -->
	<joint name="joint3" type="revolute">
		<parent link="link2"/>
		<child link="link3"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		<axis xyz="1 0 0"/>
		<limit effort="50" velocity="3.0" lower="-3.14159" upper="3.14159"/>
	</joint>

	<!-- End-effector 0.4 m from shoulder center along local Z -->
	<joint name="ee_joint" type="fixed">
		<parent link="link3"/>
		<child link="ee_link"/>
		<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.4"/>
	</joint>

	<!-- ********** INERTIAL PROPERTIES (LINKS) ********** -->
	<link name="world"/>

	<link name="base_link">
		<inertial>
			<mass value="5.0"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.1"/>
			<inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
		</inertial>
	</link>

	<link name="link1">
		<inertial>
			<mass value="2.0"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
			<inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
		</inertial>
	</link>

	<link name="link2">
		<inertial>
			<mass value="1.5"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
			<inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
		</inertial>
	</link>

	<link name="link3">
		<inertial>
			<mass value="1.0"/>
			<origin rpy="0 0 0" xyz="0.0 0.0 0.2"/>
			<inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.005"/>
		</inertial>
	</link>

	<link name="ee_link"/>
</robot>
